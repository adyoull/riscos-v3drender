910 PROCcopy("scroll 640 x 383 up a row", 0,1, 640,383, 0,0)
920 PROCcopy("scroll 600 x 300 down 7, right 3", 0,0, 600,300, 3,7)
930 PROCcopy("scroll 400 x 200 left 70", 70,10, 400,200, 0,10)
940 PROCcopy("scroll 300 x 300 up 64, left 64", 64,64, 300,300, 0,0)
950 PROCcopy("64 x 16 (the fewest rows the GPU takes)", 10,300, 64,16, 300,300)
960 PROCcopy("odd edges: 129 x 77 from 1,3 to 6,250", 1,3, 129,77, 6,250)
970 PROCcopy("30 x 30", 0,0, 30,30, 100,100)
980 PROCfill("300 x 200 orange", 100,50, 300,200, &4080FF00)
990 PROCfill("640 x 384 grey", 0,0, 640,384, &80808000)
1000 PROCfill("101 x 99 at 7,9 teal", 7,9, 101,99, &80800000)
1010 PROCfill("512 x 32 green", 0,0, 512,32, &00FF0000)
1020 PROCfill("64 x 64 white", 200,200, 64,64, &FFFFFF00)
