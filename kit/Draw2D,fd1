1040 DEF PROCcopy(t$,sx%,sy%,w%,h%,dx%,dy%)
1050 PROCrun(t$,1,sx%,sy%,w%,h%,dx%,dy%)
1060 ENDPROC
1070 DEF PROCfill(t$,x%,y%,w%,h%,c%)
1080 PROCrun(t$,2,x%,y%,w%,h%,c%,0)
1090 ENDPROC
1100 REM op 1: copy (x,y,w,h) to (p,q); op 2: fill (x,y,w,h) with colour p
1110 REM (&BBGGRR00); pixels from the region's top left
1120 DEF PROCrun(t$,op%,x%,y%,w%,h%,p%,q%)
1130 LOCAL d%
1140 PROCput:PROCaccel(FALSE):PROCop(op%,x%,y%,w%,h%,p%,q%):PROCget(a%)
1150 PROCput:PROCaccel(TRUE):PROCop(op%,x%,y%,w%,h%,p%,q%):PROCsync:PROCget(b%)
1160 A%=a%:B%=b%:C%=rb%*rh%:d%=USR cmp%
1170 IF d%=-1 THEN PROCcheck(TRUE,t$) ELSE PROCcheck(FALSE,t$+": differs at row "+STR$(d% DIV rb%)+", pixel "+STR$((d% MOD rb%) DIV bpp%)+" (CPU &"+STR$~(a%!(d% AND NOT 3))+", GPU &"+STR$~(b%!(d% AND NOT 3))+")")
1180 ENDPROC
1190 DEF PROCop(op%,x%,y%,w%,h%,p%,q%)
1200 IF op%=1 THEN MOVE FNx(x%),FNy(y%+h%-1):MOVE FNx(x%+w%-1),FNy(y%):PLOT 190,FNx(p%),FNy(q%+h%-1)
1210 IF op%=2 THEN SYS "ColourTrans_SetGCOL",p%,,,0,0:MOVE FNx(x%),FNy(y%+h%-1):PLOT 101,FNx(x%+w%-1),FNy(y%)
1220 ENDPROC
1230 DEF PROCtime(t$,op%,x%,y%,w%,h%,p%,q%)
1240 LOCAL i%,t0%,cpu%,gpu%,r$
1250 PROCput
1260 PROCaccel(FALSE):SYS "OS_ReadMonotonicTime" TO t0%
1270 FOR i%=1 TO n%:PROCop(op%,x%,y%,w%,h%,p%,q%):NEXT
1280 SYS "OS_ReadMonotonicTime" TO cpu%:cpu%-=t0%
1290 PROCput
1300 PROCaccel(TRUE):SYS "OS_ReadMonotonicTime" TO t0%
1310 FOR i%=1 TO n%:PROCop(op%,x%,y%,w%,h%,p%,q%):NEXT
1320 PROCsync
1330 SYS "OS_ReadMonotonicTime" TO gpu%:gpu%-=t0%
1340 r$="":IF gpu% THEN r$=" ("+STR$(INT(cpu%/gpu%*100+.5)/100)+" x)"
1350 PROCsay("  "+t$+": CPU "+STR$(cpu%*10)+" ms ("+STR$(cpu%*10000 DIV n%)+" us each), GPU "+STR$(gpu%*10)+" ms ("+STR$(gpu%*10000 DIV n%)+" us each)"+r$)
1360 ENDPROC
1370 REM hardware acceleration (OS_ScreenMode 4 bit 2 clear) on or off
1380 DEF PROCaccel(on%)
1390 IF on% THEN SYS "OS_ScreenMode",4,mflags% ELSE SYS "OS_ScreenMode",4,mflags% OR 4
1400 ENDPROC
1410 REM not waited for: GraphicsV 13 op 0 with "synchronise", as the OS asks
1420 DEF PROCsync
1430 IF async% THEN SYS "OS_CallAVector",1,0,0,0,13,,,,,42
1440 ENDPROC
1450 DEF FNx(px%)=(rx%+px%)<<xe%
1460 DEF FNy(py%)=(ylim%-(ry%+py%))<<ye%
1470 DEF PROCput
1480 A%=scr%+ry%*stride%+rx%*bpp%:B%=pat%:C%=rb%:D%=rh%:E%=stride%:F%=rb%:CALL copy%
1490 ENDPROC
1500 DEF PROCget(m%)
1510 A%=m%:B%=scr%+ry%*stride%+rx%*bpp%:C%=rb%:D%=rh%:E%=rb%:F%=stride%:CALL copy%
1520 ENDPROC
1530 DEF PROCpattern
1540 LOCAL x%,y%,s%
1550 s%=12345
1560 FOR y%=0 TO rh%-1
1570  FOR x%=0 TO rb%-4 STEP 4
1580   s%=s% EOR (s%<<13):s%=s% EOR (s%>>>17):s%=s% EOR (s%<<5)
1590   pat%!(y%*rb%+x%)=s% EOR (x%<<8) EOR y%
1600  NEXT
1610 NEXT
1620 ENDPROC
1630 DEF PROCasm
1640 LOCAL pass%
1650 DIM code% 256
1660 FOR pass%=0 TO 2 STEP 2
1670 P%=code%
1680 [OPT pass%
1690 .copy%
1700 STMFD R13!,{R4-R8,R14}
1710 .crow
1720 MOV R6,#0
1730 .ccol
1740 LDR R7,[R1,R6]:STR R7,[R0,R6]:ADD R6,R6,#4:CMP R6,R2:BLT ccol
1750 ADD R0,R0,R4:ADD R1,R1,R5:SUBS R3,R3,#1:BNE crow
1760 LDMFD R13!,{R4-R8,PC}
1770 .cmp%
1780 STMFD R13!,{R4,R14}
1790 MOV R3,#0
1800 .cl
1810 CMP R3,R2:BGE same
1820 LDR R4,[R0,R3]:LDR R12,[R1,R3]:CMP R4,R12:BNE diff
1830 ADD R3,R3,#4:B cl
1840 .same
1850 MVN R0,#0:LDMFD R13!,{R4,PC}
1860 .diff
1870 MOV R0,R3:LDMFD R13!,{R4,PC}
1880 ]
1890 NEXT
1900 ENDPROC
1910 REM the 2D lines of *V3DRender (s%=1: shown)
1920 DEF PROCstatus(s%)
1930 LOCAL f%,l$
1940 OSCLI "Spool "+dir$+".2DStatus":OSCLI "V3DRender":OSCLI "Spool"
1950 f%=OPENIN(dir$+".2DStatus")
1960 WHILE NOT EOF#f%
1970  l$=GET$#f%
1980  IF s% AND (INSTR(l$,"(2D)") OR INSTR(l$," by the GPU") OR INSTR(l$,"GPU work") OR INSTR(l$,"left to the CPU")) THEN PROCsay(l$)
1990 ENDWHILE
2000 CLOSE#f%
2010 ENDPROC
2020 DEF PROCspool
2030 LOCAL f%,l$
2040 OSCLI "Spool "+dir$+".2DStatus":OSCLI "V3DRender":OSCLI "Spool"
2050 f%=OPENIN(dir$+".2DStatus")
2060 WHILE NOT EOF#f%:l$=GET$#f%:IF l$<>"" THEN BPUT#out%,l$
2070 ENDWHILE
2080 CLOSE#f%
2090 ENDPROC
